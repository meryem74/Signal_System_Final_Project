from google.colab import drive
import os
import librosa
import numpy as np
import warnings
import scipy.stats as stats
import xgboost as xgb
import lightgbm as lgb
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.ensemble import RandomForestClassifier, VotingClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
import matplotlib.pyplot as plt
import seaborn as sns

# Uyarıları tamamen gizle (LightGBM bazen çok fazla bilgi mesajı basar)
warnings.filterwarnings('ignore')
os.environ["LGBM_WARNING"] = "0"

# 1. Drive Bağlantısı
drive.mount('/content/drive', force_remount=True)
DATASET_PATH = '/content/drive/MyDrive/Midterm_Dataset_2026'

# 2. Etiket Eşleştirme
def get_emotion_label(filename):
    name = filename.lower()
    if 'angry' in name or 'ofkeli' in name or 'öfkeli' in name: return 'Angry'
    if 'happy' in name or 'mutlu' in name: return 'Happy'
    if 'neutral' in name or 'notr' in name or 'nötr' in name: return 'Neutral'
    if 'sad' in name or 'uzgun' in name or 'üzgün' in name: return 'Sad'
    if 'surprised' in name or 'saskin' in name or 'şaşkın' in name: return 'Surprised'
    return None

# 3. İSTATİSTİKSEL MATRİS OLUŞTURUCU
def extract_statistics(feature_array):
    feature_array = np.nan_to_num(feature_array)
    mean = np.mean(feature_array, axis=1)
    std = np.std(feature_array, axis=1)
    min_v = np.min(feature_array, axis=1)
    max_v = np.max(feature_array, axis=1)
    skewness = stats.skew(feature_array, axis=1)
    kurtosis = stats.kurtosis(feature_array, axis=1)
    return np.concatenate((mean, std, min_v, max_v, skewness, kurtosis))

# 4. MAKSİMUM ÖZNİTELİK (FEATURE) ÇIKARIMI
def extract_max_features(file_path):
    try:
        audio, sample_rate = librosa.load(file_path, sr=None) 
        if len(audio) == 0: return None
        audio, _ = librosa.effects.trim(audio)

        # Frekans ve Ton Özellikleri
        mfccs = librosa.feature.mfcc(y=audio, sr=sample_rate, n_mfcc=40)
        mel = librosa.feature.melspectrogram(y=audio, sr=sample_rate)
        stft = np.abs(librosa.stft(audio))
        chroma = librosa.feature.chroma_stft(S=stft, sr=sample_rate) # Yeni: Duygu tonlamaları için çok güçlü
        
        # Zaman ve Enerji Özellikleri
        ste = librosa.feature.rms(y=audio)
        zcr = librosa.feature.zero_crossing_rate(y=audio)
        
        # Pitch (F0)
        pitches, magnitudes = librosa.piptrack(y=audio, sr=sample_rate)
        pitch_track = np.zeros(pitches.shape[1])
        for t in range(pitches.shape[1]):
            index = magnitudes[:, t].argmax()
            pitch_track[t] = pitches[index, t]
        pitch_track = pitch_track.reshape(1, -1)

        # İstatistiksel Sıkıştırma
        features = np.concatenate((
            extract_statistics(mfccs),
            extract_statistics(mel),
            extract_statistics(chroma), # Yeni eklendi
            extract_statistics(ste),
            extract_statistics(zcr),
            extract_statistics(pitch_track)
        ))
        return features
        
    except Exception as e:
        return None

# 5. VERİ YÜKLEME
print("Maksimum öznitelikler çıkarılıyor. Lütfen bekleyin...")
features, labels = [], []

for root, dirs, files in os.walk(DATASET_PATH):
    for file in files:
        if file.endswith('.wav'):
            file_path = os.path.join(root, file)
            label = get_emotion_label(file)
            if label is not None:
                data = extract_max_features(file_path)
                if data is not None:
                    data = np.nan_to_num(data)
                    features.append(data)
                    labels.append(label)

X = np.array(features)
y = np.array(labels)

print(f"Toplam işlenen geçerli ses dosyası: {len(X)}")

# 6. VERİ ÖN İŞLEME VE ŞİFRELEME (XGBoost sayısal etiket ister)
le = LabelEncoder()
y_encoded = le.fit_transform(y) # Örn: 'Angry' -> 0, 'Happy' -> 1

X_train, X_test, y_train, y_test = train_test_split(X, y_encoded, test_size=0.2, random_state=42, stratify=y_encoded)

scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# 7. ŞAMPİYON MODELLERİN KURULUMU VE OYLAMA SİSTEMİ
print("Extreme Gradient Boosting ve LightGBM Modelleri Eğitiliyor...")

# Model A: XGBoost (Ağaç tabanlı algoritmaların en güçlüsü)
xgb_model = xgb.XGBClassifier(n_estimators=300, learning_rate=0.05, max_depth=6, subsample=0.8, colsample_bytree=0.8, random_state=42)

# Model B: LightGBM (Hızlı ve yüksek doğruluklu varyasyon)
lgbm_model = lgb.LGBMClassifier(n_estimators=300, learning_rate=0.05, max_depth=6, subsample=0.8, random_state=42, verbose=-1)

# Model C: Random Forest (Dengeli temel model)
rf_model = RandomForestClassifier(n_estimators=300, max_depth=15, class_weight='balanced', random_state=42)

# Ortak Akıl (Soft Voting: Tüm modeller oylama yapar ve oranlar birleştirilir)
ensemble_model = VotingClassifier(
    estimators=[('xgb', xgb_model), ('lgbm', lgbm_model), ('rf', rf_model)],
    voting='soft'
)

ensemble_model.fit(X_train_scaled, y_train)

# 8. TAHMİN VE RAPORLAMA
y_pred_encoded = ensemble_model.predict(X_test_scaled)
accuracy = accuracy_score(y_test, y_pred_encoded)

# Etiketleri geri çevir (0,1 -> Angry, Happy)
y_test_labels = le.inverse_transform(y_test)
y_pred_labels = le.inverse_transform(y_pred_encoded)

print("\n" + "="*50)
print(f"MAKSİMUM FAZ 1 - Model Doğruluk (Accuracy) Oranı: %{accuracy * 100:.2f}")
print("="*50 + "\n")
print("Detaylı Sınıflandırma Raporu:\n", classification_report(y_test_labels, y_pred_labels))

# Karmaşıklık Matrisi
cm = confusion_matrix(y_test_labels, y_pred_labels, labels=le.classes_)
plt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='Purples', xticklabels=le.classes_, yticklabels=le.classes_)
plt.title('Max Boost - Duygu Sınıflandırma Karmaşıklık Matrisi')
plt.ylabel('Gerçek Değerler')
plt.xlabel('Tahmin Edilen Değerler')
plt.show()
