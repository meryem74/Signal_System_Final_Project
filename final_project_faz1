from google.colab import drive
import os
import librosa
import numpy as np
import warnings
import xgboost as xgb
import lightgbm as lgb
from catboost import CatBoostClassifier
from imblearn.over_sampling import SMOTE
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import RobustScaler, LabelEncoder
from sklearn.neural_network import MLPClassifier
from sklearn.svm import SVC
from sklearn.ensemble import StackingClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
import matplotlib.pyplot as plt
import seaborn as sns

warnings.filterwarnings('ignore')

# 1. Drive Bağlantısı
drive.mount('/content/drive', force_remount=True)
DATASET_PATH = '/content/drive/MyDrive/Midterm_Dataset_2026'

# 2. Etiket Eşleştirme
def get_emotion_label(filename):
    name = filename.lower()
    if 'angry'   in name or 'ofkeli' in name or 'öfkeli'  in name: return 'Angry'
    if 'happy'   in name or 'mutlu'  in name:                       return 'Happy'
    if 'neutral' in name or 'notr'   in name or 'nötr'    in name: return 'Neutral'
    if 'sad'     in name or 'uzgun'  in name or 'üzgün'   in name: return 'Sad'
    if 'surprised' in name or 'saskin' in name or 'şaşkın' in name: return 'Surprised'
    return None

# 3. YIN PITCH DESTEKLİ ÖZNİTELİK ÇIKARIMI
def extract_features(audio, sample_rate):
    """YIN algoritması ile hızlı Pitch tespiti ve genişletilmiş özellikler."""
    stft = np.abs(librosa.stft(audio))

    # --- A. MFCC + Delta + Delta2 ---
    mfccs  = librosa.feature.mfcc(y=audio, sr=sample_rate, n_mfcc=40)
    d_mfcc = librosa.feature.delta(mfccs)
    d2_mfcc= librosa.feature.delta(mfccs, order=2)

    # --- B. HIZLI PITCH (YIN Algoritması) ---
    # fmin ve fmax insan sesi aralığına (C2-C7) göre optimize edildi
    f0 = librosa.yin(audio, fmin=librosa.note_to_hz('C2'), 
                     fmax=librosa.note_to_hz('C7'), sr=sample_rate)
    f0 = np.nan_to_num(f0)

    # --- C. Diğer Spektral Özellikler ---
    contrast = librosa.feature.spectral_contrast(S=stft, sr=sample_rate)
    chroma = librosa.feature.chroma_stft(S=stft, sr=sample_rate)
    mel = librosa.feature.melspectrogram(y=audio, sr=sample_rate, n_mels=128)
    zcr = librosa.feature.zero_crossing_rate(audio)
    rms = librosa.feature.rms(y=audio)
    tonnetz = librosa.feature.tonnetz(y=librosa.effects.harmonic(audio), sr=sample_rate)

    def ms(feat):
        return np.hstack([np.mean(feat, axis=-1), np.std(feat, axis=-1)])

    features = np.hstack([
        ms(mfccs), ms(d_mfcc), ms(d2_mfcc),
        ms(f0.reshape(1, -1)), # Pitch Mean + Std
        ms(contrast), ms(chroma), ms(mel),
        ms(zcr), ms(rms), ms(tonnetz)
    ])
    return features

# 4. SES ARTIRMA (Augmentation)
def augment_audio(audio, sr):
    augmented = []
    # Gaussian gürültü ekle
    noise = audio + 0.005 * np.random.randn(len(audio))
    augmented.append(noise)
    # Pitch kaydır (+2 yarı ton)
    pitched = librosa.effects.pitch_shift(audio, sr=sr, n_steps=2)
    augmented.append(pitched)
    return augmented

# 5. VERİ YÜKLEME (Tam Süre, Optimize Edilmiş Örnekleme)
print("Öznitelikler çıkarılıyor (Tam Süre, 16kHz, YIN Pitch)...")
features, labels = [], []

for root, dirs, files in os.walk(DATASET_PATH):
    for file in files:
        if not file.endswith('.wav'): continue
        label = get_emotion_label(file)
        if label is None: continue

        file_path = os.path.join(root, file)
        try:
            # sr=16000 işlem hızını ciddi artırır, duration=None tamamını alır
            audio, sr = librosa.load(file_path, sr=16000, duration=None)
            if len(audio) == 0: continue
            audio, _ = librosa.effects.trim(audio)

            # Orijinal Veri
            feat = extract_features(audio, sr)
            features.append(np.nan_to_num(feat))
            labels.append(label)

            # Artırılmış Veri
            for aug_audio in augment_audio(audio, sr):
                feat_aug = extract_features(aug_audio, sr)
                features.append(np.nan_to_num(feat_aug))
                labels.append(label)

        except Exception as e:
            print(f" HATA: {file} -> {e}")

X = np.array(features)
y = np.array(labels)

# Öznitelikleri Drive'a yedekle
np.save('/content/drive/MyDrive/X_features_yin_full.npy', X)
np.save('/content/drive/MyDrive/y_labels_yin_full.npy', y)

print(f"Toplam örnek: {len(X)} | Öznitelik boyutu: {X.shape[1]}")

# 6. ÖN İŞLEME
le = LabelEncoder()
y_encoded = le.fit_transform(y)

X_train, X_test, y_train, y_test = train_test_split(
    X, y_encoded, test_size=0.2, random_state=42, stratify=y_encoded
)

scaler = RobustScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled  = scaler.transform(X_test)

# 7. SMOTE
print("SMOTE uygulanıyor...")
smote = SMOTE(random_state=42)
X_bal, y_bal = smote.fit_resample(X_train_scaled, y_train)

# 8. MODEL TANIMLARI
svc = SVC(kernel='rbf', C=20, probability=True, random_state=42)
mlp = MLPClassifier(hidden_layer_sizes=(512, 256), max_iter=600, random_state=42)
xgb_model = xgb.XGBClassifier(n_estimators=400, learning_rate=0.05, max_depth=8, random_state=42)
lgb_model = lgb.LGBMClassifier(n_estimators=400, random_state=42, verbose=-1)
cat_model = CatBoostClassifier(iterations=400, verbose=0, random_state=42)

# 9. STACKING ENSEMBLE
print("Stacking Ensemble eğitiliyor...")
stacking_model = StackingClassifier(
    estimators=[('svc', svc), ('mlp', mlp), ('xgb', xgb_model), ('lgb', lgb_model), ('cat', cat_model)],
    final_estimator=LogisticRegression(max_iter=1000),
    cv=5, 
    n_jobs=-1
)

stacking_model.fit(X_bal, y_bal)

# 10. SONUÇLAR
y_pred_enc = stacking_model.predict(X_test_scaled)
accuracy   = accuracy_score(y_test, y_pred_enc)

print("\n" + "★"*45)
print(f" MODEL DOĞRULUK (ACCURACY): %{accuracy * 100:.2f}")
print("★"*45 + "\n")
print(classification_report(le.inverse_transform(y_test), le.inverse_transform(y_pred_enc)))

# Karmaşıklık Matrisi
cm = confusion_matrix(y_test, y_pred_enc)
plt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='magma',
            xticklabels=le.classes_, yticklabels=le.classes_)
plt.title('Final Model - Karmaşıklık Matrisi')
plt.show()
