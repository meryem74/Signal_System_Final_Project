from google.colab import drive
import os, warnings
import librosa
import numpy as np
import xgboost as xgb
import lightgbm as lgb
from catboost import CatBoostClassifier
from imblearn.over_sampling import SMOTE
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import RobustScaler, LabelEncoder
from sklearn.neural_network import MLPClassifier
from sklearn.svm import SVC
from sklearn.ensemble import StackingClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.feature_selection import SelectKBest, f_classif
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
import matplotlib.pyplot as plt
import seaborn as sns

warnings.filterwarnings('ignore')

drive.mount('/content/drive', force_remount=True)
DATASET_PATH = '/content/drive/MyDrive/Midterm_Dataset_2026'

# ── Etiket ──────────────────────────────────────────────────
def get_emotion_label(filename):
    name = filename.lower()
    if 'angry'     in name or 'ofkeli' in name or 'öfkeli'  in name: return 'Angry'
    if 'happy'     in name or 'mutlu'  in name:                       return 'Happy'
    if 'neutral'   in name or 'notr'   in name or 'nötr'    in name:  return 'Neutral'
    if 'sad'       in name or 'uzgun'  in name or 'üzgün'   in name:  return 'Sad'
    if 'surprised' in name or 'saskin' in name or 'şaşkın'  in name:  return 'Surprised'
    return None

# ── ÖZNİTELİK (pyin YOK — hızlı versiyon) ──────────────────
def ms(feat):
    arr = np.array(feat)
    if arr.ndim == 1: arr = arr.reshape(1, -1)
    return np.hstack([np.mean(arr, axis=1), np.std(arr, axis=1)])

def extract_features(audio, sr):
    stft = np.abs(librosa.stft(audio))

    mfccs   = librosa.feature.mfcc(y=audio, sr=sr, n_mfcc=40)
    d_mfcc  = librosa.feature.delta(mfccs)
    d2_mfcc = librosa.feature.delta(mfccs, order=2)

    contrast    = librosa.feature.spectral_contrast(S=stft, sr=sr)
    chroma      = librosa.feature.chroma_stft(S=stft, sr=sr)
    chroma_cens = librosa.feature.chroma_cens(y=audio, sr=sr)
    mel_db      = librosa.power_to_db(
                    librosa.feature.melspectrogram(y=audio, sr=sr, n_mels=64), ref=np.max)

    spec_centroid  = librosa.feature.spectral_centroid(S=stft, sr=sr)
    spec_bandwidth = librosa.feature.spectral_bandwidth(S=stft, sr=sr)
    spec_rolloff   = librosa.feature.spectral_rolloff(S=stft, sr=sr)
    spec_flatness  = librosa.feature.spectral_flatness(S=stft)

    zcr = librosa.feature.zero_crossing_rate(audio)
    rms = librosa.feature.rms(y=audio)

    # Harmonik/Vurmalı ayrışım (pyin'den daha hızlı)
    harmonic, percussive = librosa.effects.hpss(audio)
    rms_harm = librosa.feature.rms(y=harmonic)
    rms_perc = librosa.feature.rms(y=percussive)
    tonnetz  = librosa.feature.tonnetz(y=harmonic, sr=sr)

    # Yin ile pitch (pyin'den ~10x hızlı)
    f0 = librosa.yin(audio, fmin=librosa.note_to_hz('C2'),
                     fmax=librosa.note_to_hz('C7'))
    f0 = np.nan_to_num(f0)

    from scipy.stats import kurtosis, skew
    mfcc_kurt = kurtosis(mfccs, axis=1)
    mfcc_skew = skew(mfccs, axis=1)

    return np.nan_to_num(np.hstack([
        ms(mfccs), ms(d_mfcc), ms(d2_mfcc),
        ms(contrast), ms(chroma), ms(chroma_cens),
        ms(mel_db),
        ms(spec_centroid), ms(spec_bandwidth),
        ms(spec_rolloff),  ms(spec_flatness),
        ms(zcr), ms(rms),
        ms(rms_harm), ms(rms_perc),
        ms(tonnetz),
        ms(f0.reshape(1, -1)),   # yin — hızlı pitch
        mfcc_kurt, mfcc_skew,
    ]))

# ── AUGMENTATION (3'e düşürüldü — hız için) ─────────────────
def augment_audio(audio, sr):
    variants = []
    variants.append(audio + 0.004 * np.random.randn(len(audio)))           # noise
    variants.append(librosa.effects.pitch_shift(audio, sr=sr, n_steps=2))  # pitch+
    stretched = librosa.effects.time_stretch(audio, rate=0.9)
    variants.append(stretched[:len(audio)])                                  # yavaşlat
    return variants

# ── VERİ YÜKLEME ─────────────────────────────────────────────
print("Veri yükleniyor...")
features, labels = [], []

for root, dirs, files in os.walk(DATASET_PATH):
    for file in sorted(files):
        if not file.endswith('.wav'): continue
        label = get_emotion_label(file)
        if label is None: continue
        try:
            audio, sr = librosa.load(os.path.join(root, file), sr=22050)  # sabit sr → hız
            if len(audio) < sr * 0.3: continue
            audio, _ = librosa.effects.trim(audio, top_db=20)

            features.append(extract_features(audio, sr))
            labels.append(label)

            for aug in augment_audio(audio, sr):
                features.append(extract_features(aug, sr))
                labels.append(label)

        except: pass

X = np.array(features)
y = np.array(labels)
print(f"Toplam örnek: {len(X)}  |  Boyut: {X.shape[1]}")
print({c: int(np.sum(y==c)) for c in np.unique(y)})

# ── ÖN İŞLEME ───────────────────────────────────────────────
le = LabelEncoder()
y_enc = le.fit_transform(y)

X_train, X_test, y_train, y_test = train_test_split(
    X, y_enc, test_size=0.15, random_state=42, stratify=y_enc)

scaler = RobustScaler()
X_tr_sc = scaler.fit_transform(X_train)
X_te_sc = scaler.transform(X_test)

selector = SelectKBest(f_classif, k=min(350, X.shape[1]))
X_tr_sel = selector.fit_transform(X_tr_sc, y_train)
X_te_sel = selector.transform(X_te_sc)

smote = SMOTE(random_state=42)
X_bal, y_bal = smote.fit_resample(X_tr_sel, y_train)
print(f"SMOTE sonrası: {len(X_bal)} örnek")

# ── MODELLER (sabit hiperparametre — Optuna yok) ─────────────
svc = SVC(kernel='rbf', C=50, gamma='scale', probability=True, random_state=42)

lgb_model = lgb.LGBMClassifier(
    n_estimators=500, learning_rate=0.05, num_leaves=63,
    subsample=0.8, colsample_bytree=0.8,
    random_state=42, verbose=-1)

xgb_model = xgb.XGBClassifier(
    n_estimators=500, learning_rate=0.05, max_depth=8,
    subsample=0.8, colsample_bytree=0.8,
    eval_metric='mlogloss', random_state=42)

cat_model = CatBoostClassifier(
    iterations=400, learning_rate=0.05,
    depth=8, random_state=42, verbose=0)

mlp = MLPClassifier(
    hidden_layer_sizes=(256, 128, 64),
    max_iter=500, alpha=0.001,
    early_stopping=True,
    random_state=42)

# ── STACKING ─────────────────────────────────────────────────
print("Stacking eğitiliyor...")
stacking = StackingClassifier(
    estimators=[
        ('svc', svc), ('lgb', lgb_model),
        ('xgb', xgb_model), ('cat', cat_model), ('mlp', mlp)
    ],
    final_estimator=LogisticRegression(max_iter=1000, C=10, random_state=42),
    cv=5, stack_method='predict_proba',
    passthrough=False,   # True yaparsanız +5 dk ama genelde +%1
    n_jobs=-1
)
stacking.fit(X_bal, y_bal)

# ── SONUÇ ────────────────────────────────────────────────────
y_pred = stacking.predict(X_te_sel)
acc    = accuracy_score(y_test, y_pred)

y_test_lbl = le.inverse_transform(y_test)
y_pred_lbl = le.inverse_transform(y_pred)

print(f"\n{'★'*50}")
print(f"  ACCURACY: %{acc*100:.2f}")
print(f"{'★'*50}\n")
print(classification_report(y_test_lbl, y_pred_lbl))

cm = confusion_matrix(y_test_lbl, y_pred_lbl, labels=le.classes_)
plt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='inferno',
            xticklabels=le.classes_, yticklabels=le.classes_)
plt.title(f'Stacking Ensemble  |  Accuracy: %{acc*100:.2f}')
plt.ylabel('Gerçek'); plt.xlabel('Tahmin')
plt.tight_layout(); plt.show()
